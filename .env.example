# nttd environment variables
# Copy to .env and adjust paths as needed.

# neuro-san MAS paths (used by both nttd server and nttd mas neuro-san)
AGENT_MANIFEST_FILE=examples/neuro_san_mas/registries/manifest.hocon
AGENT_TOOL_PATH=examples/neuro_san_mas/coded_tools

# API keys (loaded by nttd mas neuro-san for the neuro-san server process)
# OPENAI_API_KEY=sk-...
